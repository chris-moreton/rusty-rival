+            .unwrap_or(0)
+    });
+    if *INTERVENTION == 1 && start == 457126 && ply == 3 && depth == 10 {
+        eprintln!("INTERVENTION full-depth Ka2 at node {}", start);
+        depth = 12;
+    }
+    if trace_enabled(ply) {
+        eprintln!(
+            "TRACE\tenter\t{}\t{}\t{}\t{}\t{}\t{}\t{}\t{}\t{}",
+            start,
+            search_state.iterative_depth,
+            ply,
+            depth,
+            window.0,
+            window.1,
+            on_null_move,
+            excluded_move,
+            crate::fen::get_fen(position)
+        );
+    }
+    let result = search_inner(
+        position,
+        depth,
+        ply,
+        window,
+        search_state,
+        on_null_move,
+        excluded_move,
+        known_in_check,
+    );
+    if trace_enabled(ply) {
+        eprintln!(
+            "TRACE\texit\t{}\t{}\t{}\t{}\t{}\t{}\t{}",
+            start,
+            search_state.nodes,
+            search_state.iterative_depth,
+            ply,
+            depth,
+            result.1,
+            crate::fen::algebraic_path_from_path(&result.0)
+        );
+    }
+    result
+}
